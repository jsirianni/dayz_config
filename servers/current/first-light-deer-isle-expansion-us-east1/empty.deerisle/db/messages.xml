<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<messages>
    <message>
        <delay>1</delay>
        <onconnect>1</onconnect>
        <text>You are playing #name</text>
    </message>

    <message>
        <!-- Native graceful shutdown after 180 minutes of mission uptime.
             DayZ supplies countdown warnings, including 30, 10 and 5 minutes.
             The dzdeploy Windows service updates and relaunches after exit. -->
        <delay>0</delay>
        <repeat>0</repeat>
        <deadline>180</deadline>
        <onconnect>0</onconnect>
        <shutdown>1</shutdown>
        <text>#name will restart in #tmin minutes.</text>
    </message>
</messages>
